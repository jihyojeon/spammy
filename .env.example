# Copy to .env and fill in. Keys stay server-side only (never exposed to apps/web).

# OpenAI — analysis, award agents (Agents SDK), script, face location
OPENAI_API_KEY=

# ElevenLabs — narration (TTS with timestamps), music composition, Scribe STT
ELEVENLABS_API_KEY=
# Three fixed host voices (ElevenLabs library voice IDs), one per persona
ELEVENLABS_VOICE_GOLDIE=
ELEVENLABS_VOICE_VELVET=
ELEVENLABS_VOICE_DISCO=

# Server
HOST=127.0.0.1
PORT=8787
# Where per-show JSON, uploads, and renders are written (git-ignored)
WRAPA_DATA_DIR=./data
